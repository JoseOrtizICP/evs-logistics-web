# Copia este archivo como .env solo para desarrollo local.
# En Railway estas mismas variables se configuran en la pestaña Variables.

# La genera Railway al enlazar la base de datos PostgreSQL.
DATABASE_URL=postgresql://usuario:password@localhost:5432/evs

# Cadena larga y aleatoria (mínimo 24 caracteres). Firma las sesiones del panel.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Dominios del sitio que pueden consultar la API, separados por coma.
CORS_ORIGINS=https://www.evslogist.com,https://evslogist.com,http://localhost:5173

# Solo se usan la primera vez, para crear el usuario administrador inicial.
# Después de entrar al panel y cambiar la contraseña, borra ADMIN_PASSWORD_INICIAL.
ADMIN_EMAIL=tu-correo@evslogist.com
ADMIN_PASSWORD_INICIAL=
ADMIN_NOMBRE=Administrador

# --- Portal de clientes ---
# Puerta de desarrollador (acceso de dueño oculto). Elígelas tú; NO van en el código.
DEV_PORTAL_NUMERO=EVS-DEV
DEV_PORTAL_PASSWORD=cambia-esto-por-algo-largo-y-secreto

# Carpeta de archivos subidos (facturas y comprobantes).
# En Railway, monta un volumen y apunta esta variable a su ruta, ej. /datos/archivos.
CARPETA_ARCHIVOS=/datos/archivos
